@model IEnumerable<IIS.Application.DTOs.ScheduleDto>
@{
    ViewData["Title"] = "Расписание";

    var canMarkAttendance = User.IsInRole("Admin") || User.IsInRole("Teacher");
    var colspan = canMarkAttendance ? 8 : 7;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0"><i class="fas fa-calendar-alt text-primary me-2"></i>Расписание занятий</h5>

        @if (ViewBag.IsAdmin == true)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить занятие</a>
        }
    </div>

    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>День</th>
                    <th>Время</th>
                    <th>Дисциплина</th>
                    <th>Тип</th>
                    <th>Группа</th>
                    <th>Преподаватель</th>
                    <th>Аудитория</th>
                    @if (canMarkAttendance)
                    {
                        <th class="text-end">Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.DayOfWeek</td>
                            <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                            <td class="fw-bold">@item.SubjectName</td>
                            <td><span class="badge bg-secondary">@item.LessonType</span></td>
                            <td><span class="badge bg-info text-dark">@item.GroupName</span></td>
                            <td>@item.TeacherName</td>
                            <td>@item.Classroom</td>

                            @if (canMarkAttendance)
                            {
                                <td class="text-end">
                                    <a asp-controller="Attendance" asp-action="Mark" asp-route-scheduleId="@item.Id" class="btn btn-sm btn-outline-success">
                                        <i class="fas fa-check-square"></i> Отметить
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@colspan" class="text-center py-5 text-muted">
                            <i class="fas fa-calendar-times fa-3x mb-3 opacity-50"></i>
                            <h5>Расписание пусто</h5>
                            <p class="mb-0">Пока нет назначенных занятий.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>