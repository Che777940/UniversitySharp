@model IIS.Application.DTOs.CreateScheduleDto
@{
    ViewData["Title"] = "Новое занятие";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3"><h5 class="mb-0">Добавление в расписание</h5></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CourseId" class="form-label">Курс (Дисциплина и Группа)</label>
                            <select asp-for="CourseId" class="form-select" asp-items="ViewBag.Courses" required>
                                <option value="">-- Выберите курс --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClassroomId" class="form-label">Аудитория</label>
                            <select asp-for="ClassroomId" class="form-select" asp-items="ViewBag.Classrooms" required>
                                <option value="">-- Выберите аудиторию --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="DayOfWeek" class="form-label">День недели</label>
                            <select asp-for="DayOfWeek" class="form-select" asp-items="Html.GetEnumSelectList<DayOfWeek>()" required></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StartTime" class="form-label">Время начала</label>
                            <input asp-for="StartTime" type="time" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndTime" class="form-label">Время окончания</label>
                            <input asp-for="EndTime" type="time" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="LessonType" class="form-label">Тип занятия</label>
                        <select asp-for="LessonType" class="form-select" asp-items="Html.GetEnumSelectList<IIS.Domain.Enums.LessonType>()" required></select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>