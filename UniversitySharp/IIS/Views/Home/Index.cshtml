@using System.Security.Claims
@{
    ViewData["Title"] = "Дашборд";
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}

<style>
    .dashboard-card {
        transition: transform 0.2s;
        border-radius: 15px;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 15px;
    }
</style>

<div class="container-fluid p-0">
    <div class="mb-4">
        <h3 class="fw-bold">Добро пожаловать, @User.Identity?.Name! 👋</h3>
        <p class="text-muted">Вы вошли как: <strong>@role</strong></p>
    </div>

    @if (role == "Student")
    {
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-primary text-white"><i class="fas fa-calendar-alt"></i></div>
                        <h5 class="fw-bold text-dark">Мое расписание</h5>
                        <p class="text-muted small">Посмотреть расписание занятий на неделю.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-success text-white"><i class="fas fa-star"></i></div>
                        <h5 class="fw-bold text-dark">Мои оценки</h5>
                        <p class="text-muted small">Успеваемость и результаты сессии.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-info text-white"><i class="fas fa-id-card"></i></div>
                        <h5 class="fw-bold text-dark">Мой профиль</h5>
                        <p class="text-muted small">Личные данные и зачетная книжка.</p>
                    </div>
                </div>
            </div>
        </div>
    }

    else if (role == "Teacher")
    {
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card dashboard-card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="icon-box bg-warning text-white"><i class="fas fa-book"></i></div>
                    <h5 class="fw-bold text-dark">Мои дисциплины</h5>
                    <p class="text-muted small">Список курсов, которые вы ведете.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card dashboard-card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="icon-box bg-danger text-white"><i class="fas fa-edit"></i></div>
                    <h5 class="fw-bold text-dark">Выставить оценки</h5>
                    <p class="text-muted small">Журнал посещаемости и успеваемости.</p>
                </div>
            </div>
        </div>
    </div>
    }

    else if (role == "Admin")
    {
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Students" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-primary text-white"><i class="fas fa-user-graduate"></i></div>
                        <h5 class="fw-bold text-dark">Студенты</h5>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Courses" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-success text-white"><i class="fas fa-layer-group"></i></div>
                        <h5 class="fw-bold text-dark">Курсы</h5>
                    </div>
                </div>
            </a>
        </div>
    </div>
    }
</div>