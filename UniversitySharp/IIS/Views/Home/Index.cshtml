@{
    ViewData["Title"] = "Дашборд";
}

<style>
    .dashboard-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border-radius: 15px;
        overflow: hidden;
    }
    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 15px;
    }
</style>

<div class="container-fluid p-0">
    
    <div class="mb-4">
        <h3 class="fw-bold">Добро пожаловать в UniSys! 👋</h3>
        <p class="text-muted">Выберите нужный раздел для начала работы или просмотрите статистику.</p>
    </div>

    <div class="row g-4">
        
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Students" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <h5 class="card-title fw-bold text-dark">Студенты</h5>
                        <p class="card-text text-muted small">Управление профилями студентов и зачислением.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a asp-controller="Teachers" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-success bg-opacity-10 text-success">
                            <i class="fas fa-chalkboard-teacher"></i>
                        </div>
                        <h5 class="card-title fw-bold text-dark">Преподаватели</h5>
                        <p class="card-text text-muted small">Список преподавателей и их ученые степени.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a asp-controller="Groups" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-info bg-opacity-10 text-info">
                            <i class="fas fa-users"></i>
                        </div>
                        <h5 class="card-title fw-bold text-dark">Учебные группы</h5>
                        <p class="card-text text-muted small">Формирование и управление группами по курсам.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a asp-controller="Subjects" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-book"></i>
                        </div>
                        <h5 class="card-title fw-bold text-dark">Дисциплины</h5>
                        <p class="card-text text-muted small">Каталог предметов и количество кредитов (ЗЕТ).</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a asp-controller="Classrooms" asp-action="Index" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-secondary bg-opacity-10 text-secondary">
                            <i class="fas fa-door-open"></i>
                        </div>
                        <h5 class="card-title fw-bold text-dark">Аудитории</h5>
                        <p class="card-text text-muted small">Аудиторный фонд, корпуса и вместимость.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="#" class="text-decoration-none">
                <div class="card dashboard-card h-100 shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="icon-box bg-danger bg-opacity-10 text-danger">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <h5 class="card-title fw-bold text-dark">Расписание</h5>
                        <p class="card-text text-muted small">Просмотр и составление учебного расписания.</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-primary text-white p-4" style="border-radius: 15px; background: linear-gradient(45deg, #0d6efd, #0dcaf0);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1">Система готова к работе</h4>
                        <p class="mb-0 text-white-50">Все сервисы функционируют в штатном режиме.</p>
                    </div>
                    <i class="fas fa-server fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

</div>