@model IIS.Application.DTOs.CreateDepartmentDto
@{
    ViewData["Title"] = "Новая кафедра";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white py-3"><h5 class="mb-0">Создание кафедры</h5></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название кафедры</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FacultyId" class="form-label">Факультет</label>
                        <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.Faculties">
                            <option value="">-- Выберите факультет --</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success">Создать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>