<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                background-color: #f4f6f9;
            }

            .sidebar {
                min-height: 100vh;
                background-color: #212529;
                color: #fff;
                padding-top: 20px;
            }

                .sidebar a {
                    color: #adb5bd;
                    text-decoration: none;
                    padding: 12px 20px;
                    display: block;
                    transition: 0.3s;
                }

                    .sidebar a:hover, .sidebar a.active {
                        background-color: #0d6efd;
                        color: #fff;
                    }

                .sidebar i {
                    margin-right: 10px;
                    width: 20px;
                    text-align: center;
                }

            .main-content {
                padding: 30px;
            }

            .card {
                border: none;
                box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            }
    </style>
</head>
<body>
    @{
        // Получаем имя текущего контроллера, чтобы подсвечивать активный пункт меню
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar">
                <div class="text-center mb-4">
                    <h4 class="text-white"><i class="fas fa-university"></i> UniSys</h4>
                </div>
                <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")"><i class="fas fa-home"></i> Дашборд</a>

                <a asp-controller="Students" asp-action="Index" class="@(currentController == "Students" ? "active" : "")"><i class="fas fa-user-graduate"></i> Студенты</a>

                <a asp-controller="Groups" asp-action="Index" class="@(currentController == "Groups" ? "active" : "")"><i class="fas fa-users"></i> Группы</a>

                <a asp-controller="Departments" asp-action="Index" class="@(currentController == "Departments" ? "active" : "")"><i class="fas fa-building"></i> Кафедры</a>

                <a href="#"><i class="fas fa-chalkboard-teacher"></i> Преподаватели</a>
                <a href="#"><i class="fas fa-book"></i> Дисциплины</a>
                <a href="#"><i class="fas fa-calendar-alt"></i> Расписание</a>
            </nav>

            <main class="col-md-10 ms-sm-auto main-content">
                <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h1 class="h3">@ViewData["Title"]</h1>

                    <div class="dropdown">
                        <button class="btn btn-outline-dark dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-shield text-primary"></i>
                            <span>Администратор</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><h6 class="dropdown-header">admin@university.ru</h6></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-id-card me-2"></i>Профиль</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Настройки</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-sign-out-alt me-2"></i>Выйти</a></li>
                        </ul>
                    </div>
                </header>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>