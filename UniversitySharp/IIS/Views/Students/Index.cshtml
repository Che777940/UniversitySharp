@model IEnumerable<IIS.Application.DTOs.StudentDto>
@{
    ViewData["Title"] = "Студенты";
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0">Список студентов</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить студента</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Студент</th>
                    <th>Зачетная книжка</th>
                    <th>Группа</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var student in Model)
                    {
                        <tr class="align-middle">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                                        @student.FirstName.Substring(0, 1)@student.LastName.Substring(0, 1)
                                    </div>
                                    <div>
                                        <h6 class="mb-0">@student.LastName @student.FirstName</h6>
                                        <small class="text-muted">Студент</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-secondary">@student.RecordBookNumber</span></td>
                            <td><span class="badge bg-info text-dark">@student.GroupName</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2"></i><br />
                            Студентов пока нет. Добавьте первого!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>