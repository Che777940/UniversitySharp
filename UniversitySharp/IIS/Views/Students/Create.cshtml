@model IIS.Application.DTOs.CreateStudentDto
@{
    ViewData["Title"] = "Новый студент";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Добавление студента</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Фамилия</label>
                            <input asp-for="LastName" class="form-control" placeholder="Иванов" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">Имя</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Иван" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="RecordBookNumber" class="form-label">Номер зачетки</label>
                            <input asp-for="RecordBookNumber" class="form-control" placeholder="12345" />
                            <span asp-validation-for="RecordBookNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GroupId" class="form-label">Группа</label>
                            <select asp-for="GroupId" class="form-select" asp-items="ViewBag.Groups">
                                <option value="">-- Выберите группу --</option>
                            </select>
                            <span asp-validation-for="GroupId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="student@university.ru" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Пароль</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}