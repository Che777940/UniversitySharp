@model IEnumerable<IIS.Domain.Entities.Scheduling.Classroom>
@{ ViewData["Title"] = "Аудитории"; }

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0">Аудиторный фонд</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить аудиторию</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Номер</th>
                    <th>Корпус</th>
                    <th>Вместимость</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td><strong>@item.Number</strong></td>
                            <td>@item.Building</td>
                            <td><span class="badge bg-info text-dark"><i class="fas fa-users me-1"></i> @item.Capacity чел.</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">Аудиторий пока нет.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
