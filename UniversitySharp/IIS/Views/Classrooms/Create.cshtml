@model IIS.Application.DTOs.CreateClassroomDto
@{ ViewData["Title"] = "Новая аудитория"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white py-3"><h5 class="mb-0">Добавление аудитории</h5></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Number" class="form-label">Номер аудитории</label>
                        <input asp-for="Number" class="form-control" placeholder="Например, А-402" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Building" class="form-label">Корпус</label>
                        <input asp-for="Building" class="form-control" placeholder="Главный корпус" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Capacity" class="form-label">Вместимость (чел.)</label>
                        <input asp-for="Capacity" type="number" min="1" max="500" class="form-control" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success">Создать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>