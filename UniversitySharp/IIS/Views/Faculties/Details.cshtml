@model IIS.Application.DTOs.FacultyDetailsDto
@{
    ViewData["Title"] = "Структура факультета";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center py-4 bg-primary text-white rounded-top" style="border-radius: 15px 15px 0 0;">
                <h2 class="fw-bold mb-0">@Model.Name</h2>
                <p class="mb-0 opacity-75">@Model.ShortName</p>
            </div>
            <div class="card-body p-0">
                <h5 class="p-3 mb-0 border-bottom bg-light"><i class="fas fa-building me-2"></i>Кафедры на факультете</h5>
                <ul class="list-group list-group-flush">
                    @if (Model.Departments.Any())
                    {
                        foreach (var dept in Model.Departments)
                        {
                            <li class="list-group-item py-3">
                                <i class="fas fa-chalkboard text-muted me-2"></i> <strong>@dept.Name</strong>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted py-3">На этом факультете пока нет кафедр.</li>
                    }
                </ul>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Назад к факультетам</a>
    </div>
</div>