@model IEnumerable<IIS.Domain.Entities.Structure.Faculty>
@{
    ViewData["Title"] = "Факультеты";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0"><i class="fas fa-university text-primary me-2"></i>Факультеты</h5>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить факультет</a>
        }
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Название</th>
                    <th>Аббревиатура</th>
                    <th>Кол-во кафедр</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fac in Model)
                    {
                        <tr>
                            <td class="fw-bold">@fac.Name</td>
                            <td><span class="badge bg-secondary">@fac.ShortName</span></td>
                            <td>@fac.Departments.Count</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@fac.Id" class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i> Структура
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">Факультетов пока нет.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>