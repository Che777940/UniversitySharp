@model IIS.Application.DTOs.ProfileDto
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="fas fa-id-card me-2"></i>Личный кабинет</h4>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center me-4" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">@(Model.FirstName != null ? $"{Model.LastName} {Model.FirstName}" : Model.Email)</h3>
                        <span class="badge bg-info text-dark fs-6">@Model.Role</span>
                    </div>
                </div>

                <hr />
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-bold">Email:</div>
                    <div class="col-sm-8">@Model.Email</div>
                </div>

                @if (Model.Role == "Student")
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Группа:</div>
                        <div class="col-sm-8"><span class="badge bg-secondary">@Model.GroupName</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Номер зачетки:</div>
                        <div class="col-sm-8">@Model.RecordBookNumber</div>
                    </div>
                }
                else if (Model.Role == "Teacher")
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Кафедра:</div>
                        <div class="col-sm-8">@Model.DepartmentName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Ученая степень:</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Degree) ? "—" : Model.Degree)</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>