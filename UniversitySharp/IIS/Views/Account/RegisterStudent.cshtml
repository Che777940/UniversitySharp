@model IIS.Application.DTOs.RegisterStudentDto
@{ ViewData["Title"] = "Регистрация студента"; }

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0"><i class="fas fa-user-graduate"></i> Регистрация студента</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="RegisterStudent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Фамилия</label>
                            <input asp-for="LastName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">Имя</label>
                            <input asp-for="FirstName" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="RecordBookNumber" class="form-label">Номер зачетки</label>
                            <input asp-for="RecordBookNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GroupId" class="form-label">Группа</label>
                            <select asp-for="GroupId" class="form-select" asp-items="ViewBag.Groups" required>
                                <option value="">-- Выберите группу --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email (Логин)</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Пароль</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Login" class="text-decoration-none">Уже есть аккаунт? Войти</a>
                        <button type="submit" class="btn btn-success px-4">Зарегистрироваться</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>