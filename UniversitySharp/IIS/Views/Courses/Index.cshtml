@model IEnumerable<IIS.Domain.Entities.Academics.Course>
@{
    ViewData["Title"] = "Курсы";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0"><i class="fas fa-layer-group text-primary me-2"></i>Учебные курсы</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Назначить курс
        </a>
    </div>

    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Дисциплина</th>
                    <th>Преподаватель</th>
                    <th>Группа</th>
                    <th>Семестр</th>
                    <th>Учебный год</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var course in Model)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@course.Subject?.Name</td>
                            <td>@course.Teacher?.LastName @course.Teacher?.FirstName</td>
                            <td><span class="badge bg-info text-dark">@course.Group?.Name</span></td>
                            <td>
                                @if (course.Semester == IIS.Domain.Enums.Semester.First)
                                {
                                    <span class="badge bg-secondary">1-й (Осенний)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">2-й (Весенний)</span>
                                }
                            </td>
                            <td>@course.AcademicYear</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fas fa-folder-open fa-3x mb-3 opacity-50"></i>
                            <h5>Курсов пока нет</h5>
                            <p class="mb-0">Нажмите «Назначить курс», чтобы связать дисциплину, преподавателя и группу.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>