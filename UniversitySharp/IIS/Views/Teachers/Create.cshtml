@model IIS.Application.DTOs.CreateTeacherDto
@{ ViewData["Title"] = "Новый преподаватель"; }

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white py-3"><h5 class="mb-0">Добавление преподавателя</h5></div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Фамилия</label>
                            <input asp-for="LastName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">Имя</label>
                            <input asp-for="FirstName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Degree" class="form-label">Ученая степень (необязательно)</label>
                            <input asp-for="Degree" class="form-control" placeholder="К.т.н., Доцент" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label">Кафедра</label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" required>
                                <option value="">-- Выберите кафедру --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="teacher@university.ru" required />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success">Создать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>