@model IEnumerable<IIS.Domain.Entities.Identity.Teacher>
@{ ViewData["Title"] = "Преподаватели"; }

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0">Преподавательский состав</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить преподавателя</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ФИО</th>
                    <th>Степень</th>
                    <th>Кафедра</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-success text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                                        @item.FirstName.Substring(0, 1)@item.LastName.Substring(0, 1)
                                    </div>
                                    <strong>@item.LastName @item.FirstName</strong>
                                </div>
                            </td>
                            <td>@(string.IsNullOrEmpty(item.Degree) ? "—" : item.Degree)</td>
                            <td><span class="badge bg-secondary">@item.Department?.Name</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">Преподавателей пока нет.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>