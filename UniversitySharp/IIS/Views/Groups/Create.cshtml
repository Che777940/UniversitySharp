@model IIS.Application.DTOs.CreateGroupDto
@{
    ViewData["Title"] = "Новая группа";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Создание группы</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название группы (например, ИС-21)</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="CourseNumber" class="form-label">Номер курса</label>
                        <input asp-for="CourseNumber" type="number" min="1" max="6" class="form-control" required />
                    </div>
                    <div class="mb-3">
                    <label asp-for="DepartmentId" class="form-label">Кафедра</label>
                     <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                       <option value="">-- Выберите кафедру --</option>
                     </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Создать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>