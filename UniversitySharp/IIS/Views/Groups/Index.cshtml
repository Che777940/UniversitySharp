@model IEnumerable<IIS.Domain.Entities.Structure.Group>
@{
    ViewData["Title"] = "Группы";
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0">Учебные группы</h5>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Создать группу</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Название группы</th>
                    <th>Курс</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var group in Model)
                    {
                        <tr class="align-middle">
                            <td><strong>@group.Name</strong></td>
                            <td>@group.CourseNumber курс</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2"></i><br />
                            Групп пока нет. Создайте первую!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>